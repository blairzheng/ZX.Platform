DOTNET_ENVIRONMENT=Production
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://127.0.0.1:18081
ForwardedHeaders__KnownProxies__0=127.0.0.1
ForwardedHeaders__KnownProxies__1=::1
AuthenticationRedis__KeyPrefix=mom:staging:identity:auth:
AuthenticationCookie__Secure=true
# Fill privately on the servers. Both instances must use identical values.
# Redis: all three Sentinel endpoints, serviceName=mom-redis,user=default,password=...
ConnectionStrings__IdentityRedis=
ConnectionStrings__IdentityDatabase=
# Replace with the actual table owner provided by the DBA.
IdentityDatabase__Schema=SAJET
# Base64-encoded random key of at least 32 bytes, shared by both nodes.
AuthenticationJwt__SigningKey=
AuthenticationJwt__Issuer=MOM.Staging.Identity
AuthenticationJwt__Audience=MOM.Staging
