[Unit]
Description=MOM Identity API
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=3

[Service]
Type=simple
User=mom
Group=mom
WorkingDirectory=/opt/mom/current/identity
ExecStart=/usr/bin/dotnet /opt/mom/current/identity/ZX.Platform.Identity.Api.dll
EnvironmentFile=/etc/mom/identity.env
Restart=on-failure
RestartSec=10
TimeoutStopSec=60
KillSignal=SIGINT
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mom-identity
LogNamespace=mom

[Install]
WantedBy=multi-user.target
