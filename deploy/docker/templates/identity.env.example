# Docker --env-file: values are literal; do not wrap them in quotes or source this file.
# Deployment script supplies Production, HTTP :8080 and the trusted Gateway IP.
IdentityDatabase__Schema=SAJET
ConnectionStrings__IdentityDatabase=CHANGE_ME_DATABASE_CONNECTION
ConnectionStrings__IdentityRedis=10.32.15.176:26379,10.32.15.177:26379,10.32.15.178:26379,serviceName=mom-redis,user=default,password=CHANGE_ME_REDIS_PASSWORD,connectTimeout=3000,asyncTimeout=3000
AuthenticationRedis__KeyPrefix=mom:staging:identity:auth:
# Generate ONCE with: openssl rand -base64 32. Use the SAME value on 177 and 178.
AuthenticationJwt__SigningKey=CHANGE_ME_SHARED_JWT_KEY
AuthenticationJwt__Issuer=MOM.Staging.Identity
AuthenticationJwt__Audience=MOM.Staging
AuthenticationCookie__Secure=true
# Internal HTTP testing only: set Secure=false AND AllowInsecureHttp=true.
# AuthenticationCookie__AllowInsecureHttp=true

# --- OA / LDAP login (optional; leave disabled to keep local login only) ---
# Enabling requires ALL of: AuthenticationLdap__Enabled=true, a BaseDn,
# a service account BindDn + BindPassword, and at least one usable server.
# The service account password is injected here only. Never write it into
# appsettings.json, code, images, tickets or chat.
# AuthenticationLdap__Enabled=false
# AuthenticationLdap__Provider=luxshare-ad
# AuthenticationLdap__BaseDn=OU=立讯集团,DC=luxshare,DC=com,DC=cn
# AuthenticationLdap__BindDn=CHANGE_ME_SERVICE_ACCOUNT@luxshare.com.cn
# AuthenticationLdap__BindPassword=CHANGE_ME_SERVICE_ACCOUNT_PASSWORD
# Attribute names must match the directory schema confirmed by IT; employee
# number is always treated as a string, never as a number.
# AuthenticationLdap__UserNameAttribute=sAMAccountName
# AuthenticationLdap__EmployeeNumberAttribute=sAMAccountName
# The attribute used to search by the employee number typed on the login form.
# Leave empty to follow EmployeeNumberAttribute, so changing the employee number
# attribute also changes the lookup instead of staying on the login name.
# AuthenticationLdap__EmployeeLookupAttribute=
# AuthenticationLdap__SubjectAttribute=objectGUID
# AuthenticationLdap__DisplayNameAttribute=cn
# AuthenticationLdap__DepartmentAttribute=department
# AuthenticationLdap__StatusAttribute=userAccountControl
# Primary and standby directory nodes; indexes are 0 and 1.
# AuthenticationLdap__Servers__0__Host=10.41.2.10
# AuthenticationLdap__Servers__0__Port=636
# AuthenticationLdap__Servers__0__Encryption=Ldaps
# AuthenticationLdap__Servers__1__Host=10.32.12.10
# AuthenticationLdap__Servers__1__Port=636
# AuthenticationLdap__Servers__1__Encryption=Ldaps
# Prefer Ldaps or StartTls. Plain 389 transmits the service account password
# and user password in clear text; it is refused unless AllowPlainText=true
# and the risk is recorded by operations.
# AuthenticationLdap__AllowPlainText=false
# Certificate validation cannot be turned off: setting this to false makes the
# service refuse to start. Fix the chain with a trusted CA and correct host name.
# AuthenticationLdap__VerifyServerCertificate=true
# Total budget for one login or lookup, including semaphore queueing and standby
# failover; every connect, search and bind is clamped to the remaining budget.
# AuthenticationLdap__ConnectTimeoutSeconds=3
# AuthenticationLdap__OperationTimeoutSeconds=5
# AuthenticationLdap__TotalTimeoutSeconds=15
# AuthenticationLdap__MaxConcurrentOperations=8
# Per employee number, per window; keeps a wrong password from locking the AD account.
# AuthenticationLdap__MaxFailedAttempts=10
# AuthenticationLdap__FailureWindowSeconds=300
