# Docker --env-file: values are literal; do not wrap them in quotes or source this file.
# Deployment script supplies Production, HTTP :8080 and the trusted Gateway IP.
IdentityDatabase__Schema=SAJET
ConnectionStrings__IdentityDatabase=CHANGE_ME_DATABASE_CONNECTION
ConnectionStrings__IdentityRedis=10.32.15.176:26379,10.32.15.177:26379,10.32.15.178:26379,serviceName=mom-redis,user=default,password=CHANGE_ME_REDIS_PASSWORD,connectTimeout=3000,asyncTimeout=3000
AuthenticationRedis__KeyPrefix=mom:staging:identity:auth:
# Generate ONCE with: openssl rand -base64 32. Use the SAME value on 177 and 178.
AuthenticationJwt__SigningKey=CHANGE_ME_SHARED_JWT_KEY
AuthenticationJwt__Issuer=MOM.Staging.Identity
AuthenticationJwt__Audience=MOM.Staging
AuthenticationCookie__Secure=true
# Internal HTTP testing only: set Secure=false AND AllowInsecureHttp=true.
# AuthenticationCookie__AllowInsecureHttp=true
