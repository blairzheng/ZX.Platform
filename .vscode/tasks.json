{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build: Identity API",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/Services/Identity/ZX.Platform.Identity.Api/ZX.Platform.Identity.Api.csproj",
        "--no-restore"
      ],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": "$msCompile",
      "group": "build"
    },
    {
      "label": "build: Gateway",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/ZX.Platform.Gateway/ZX.Platform.Gateway.csproj",
        "--no-restore"
      ],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": "$msCompile",
      "group": "build"
    }
  ]
}
