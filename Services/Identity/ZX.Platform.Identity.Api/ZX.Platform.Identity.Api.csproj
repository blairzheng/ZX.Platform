      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.24.1-preview.1" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ZX.Platform.Identity.Application\ZX.Platform.Identity.Application.csproj" />
    <ProjectReference Include="..\ZX.Platform.Identity.Infrastructure\ZX.Platform.Identity.Infrastructure.csproj" />
  </ItemGroup>

</Project>
