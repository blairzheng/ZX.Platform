{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.HttpLogging.HttpLoggingMiddleware": "Information"
    },
    "Console": {
      "FormatterName": "simple",
      "MaxQueueLength": 1024,
      "QueueFullMode": "DropWrite",
      "FormatterOptions": {
        "SingleLine": true,
        "IncludeScopes": true,
        "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fff'Z' ",
        "UseUtcTimestamp": true
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "IdentityRedis": "127.0.0.1:6379,connectTimeout=3000,asyncTimeout=3000"
  },
  "IdentityDatabase": {
    "Schema": "ZX_IDENTITY"
  },
  "AuthenticationRedis": {
    "KeyPrefix": "zx:identity:auth:"
  },
  "AuthenticationJwt": {
    "Issuer": "ZX.Platform.Identity",
    "Audience": "ZX.Platform"
  },
  "Authentication": {
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7,
    "MaximumFailedAttempts": 5,
    "LockoutMinutes": 15
  },
  "AuthenticationCookie": {
    "Secure": true
  },
  "AuthenticationLdap": {
    "Enabled": false,
    "Provider": "luxshare-ad",
    "Servers": [
      { "Host": "10.41.2.10", "Port": 389, "Encryption": "Plain" },
      { "Host": "10.32.12.10", "Port": 389, "Encryption": "Plain" }
    ],
    "BaseDn": "OU=立讯集团,DC=luxshare,DC=com,DC=cn",
    "BindDn": "",
    "BindPassword": "",
    "UserNameAttribute": "sAMAccountName",
    "EmployeeNumberAttribute": "sAMAccountName",
    "EmployeeLookupAttribute": "",
    "SubjectAttribute": "objectGUID",
    "DisplayNameAttribute": "cn",
    "DepartmentAttribute": "department",
    "StatusAttribute": "userAccountControl",
    "ConnectTimeoutSeconds": 3,
    "OperationTimeoutSeconds": 5,
    "TotalTimeoutSeconds": 15,
    "MaxConcurrentOperations": 8,
    "VerifyServerCertificate": true,
    "AllowPlainText": false,
    "MaxFailedAttempts": 10,
    "FailureWindowSeconds": 300
  },
  "ForwardedHeaders": {
    "KnownProxies": ["127.0.0.1", "::1"]
  },
  "RateLimiting": {
    "PermitLimit": 5,
    "WindowSeconds": 3,
    "SegmentsPerWindow": 3
  }
}
