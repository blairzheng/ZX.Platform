{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.HttpLogging.HttpLoggingMiddleware": "Information"
    },
    "Console": {
      "FormatterName": "simple",
      "MaxQueueLength": 1024,
      "QueueFullMode": "DropWrite",
      "FormatterOptions": {
        "SingleLine": true,
        "IncludeScopes": true,
        "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fff'Z' ",
        "UseUtcTimestamp": true
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "IdentityRedis": "127.0.0.1:6379,connectTimeout=3000,asyncTimeout=3000"
  },
  "AuthenticationRedis": {
    "KeyPrefix": "zx:identity:auth:"
  },
  "AuthenticationJwt": {
    "Issuer": "ZX.Platform.Identity",
    "Audience": "ZX.Platform"
  },
  "Authentication": {
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7,
    "MaximumFailedAttempts": 5,
    "LockoutMinutes": 15,
    "AdministratorAccounts": []
  },
  "AuthenticationCookie": {
    "Secure": true
  },
  "ForwardedHeaders": {
    "KnownProxies": ["127.0.0.1", "::1"]
  },
  "RateLimiting": {
    "PermitLimit": 5,
    "WindowSeconds": 3,
    "SegmentsPerWindow": 3
  }
}
