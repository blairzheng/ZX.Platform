{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ForwardedHeaders": {
    "KnownProxies": ["127.0.0.1", "::1"]
  },
  "RateLimiting": {
    "PermitLimit": 5,
    "WindowSeconds": 3,
    "SegmentsPerWindow": 3
  }
}
